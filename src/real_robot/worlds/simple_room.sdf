<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="simple_room">

    <!-- Gazebo system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 조명 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         외벽 — 방 내부 3.0m(X) × 5.0m(Y), 두께 0.1m, 높이 0.8m
         좌표: 방 중심 = world (0, 0)
           x ∈ [-1.5, +1.5],  y ∈ [-2.5, +2.5]
         ============================================================ -->

    <!-- 북쪽 벽 (y=+2.5 안쪽) -->
    <model name="wall_north"><static>true</static>
      <pose>0 2.55 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.2 0.1 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.2 0.1 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 남쪽 벽 (y=-2.5 안쪽) -->
    <model name="wall_south"><static>true</static>
      <pose>0 -2.55 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.2 0.1 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.2 0.1 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 서쪽 벽 (x=-1.5 안쪽) -->
    <model name="wall_west"><static>true</static>
      <pose>-1.55 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 동쪽 벽 (x=+1.5 안쪽) -->
    <model name="wall_east"><static>true</static>
      <pose>1.55 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         가운데 칸막이 — 남쪽벽(y=-2.5) → 위로 3.6m, 위쪽 통로 폭 1.4m
         pose y_center = (-2.5 + 1.1) / 2 = -0.7
         ============================================================ -->
    <model name="partition"><static>true</static>
      <pose>-0.2 -0.7 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.6 0.8</size></box></geometry>
          <material><ambient>0.7 0.5 0.5 1</ambient><diffuse>0.7 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         책상 — 좌측 하단, 0.6 × 0.4 × 0.6 m
         ============================================================ -->
    <model name="desk"><static>true</static>
      <pose>-0.9 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.4 0.6</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>실기 로봇 통합 브링업 — 매핑/네비게이션 런치파일</description>
  <maintainer email="nblue27@gmail.com">min</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 런치파일이 런타임에 실행하는 패키지들 -->
  <exec_depend>ros2_pid_bridge</exec_depend>
  <exec_depend>ur3_4040_urdf</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>bno055_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
